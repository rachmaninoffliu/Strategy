# --- E*TRADE Developer credentials (apply at developer.etrade.com) ---
ETRADE_CONSUMER_KEY=replace_me
ETRADE_CONSUMER_SECRET=replace_me

# After the first OAuth handshake, call GET /v1/accounts/list once and copy the
# `accountIdKey` (NOT the visible account number) for the account you want to trade.
ETRADE_ACCOUNT_ID_KEY=replace_me

# Long random string. Required on every webhook call via ?secret=... or X-Webhook-Secret.
WEBHOOK_SECRET_PASSPHRASE=replace_me_with_a_long_random_string

# "sandbox" -> https://apisb.etrade.com   |   "production" -> https://api.etrade.com
ETRADE_ENV=sandbox

# --- Optional knobs ---
TOKEN_STORE_PATH=~/.etrade_bridge/tokens.json
RENEWAL_INTERVAL_MINUTES=90
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
